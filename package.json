{
  "name": "react-hooks-esp-middleware-example",
  "version": "2.0.0",
  "private": true,
  "description": "React Hooks Playground \u2014 from fundamentals to advanced production patterns, built around an esp-js event-middleware integration for React hooks.",
  "keywords": [
    "react",
    "react-hooks",
    "custom-hooks",
    "esp-js",
    "middleware",
    "useReducer",
    "typescript",
    "playground"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aqkprogrammer/react-hooks-esp-middleware-example.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:check": "tsx scripts/generate-docs.ts --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run docs:check && npm run test && npm run build"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.104.4",
    "classnames": "^2.5.1",
    "esp-js": "^8.1.0",
    "immer": "^11.1.21",
    "jotai": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "rxjs": "^7.8.2",
    "swr": "^2.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "sideEffects": [
    "*.css",
    "./src/main.tsx",
    "./src/mocks/**"
  ]
}
